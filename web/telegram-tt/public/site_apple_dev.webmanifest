{
    "name": "Parvane Beta",
    "short_name": "Parvane Beta",
    "description": "Parvane — self-hosted end-to-end encrypted messenger with a planner, notes and files.",
    "start_url": "./",
    "icons": [
        {
            "src": "icon-square-dev-192x192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "icon-square-dev-384x384.png",
            "sizes": "384x384",
            "type": "image/png"
        },
        {
            "src": "icon-square-dev-512x512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "icon-square-dev-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icon-square-dev-384x384.png",
            "sizes": "384x384",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icon-square-dev-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "share_target": {
        "action": "./share/",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "files",
                    "accept": "*/*"
                }
            ]
        }
    },
    "theme_color": "#1d2021",
    "background_color": "#1d2021",
    "display": "standalone",
    "id": "./",
    "shortcuts": [
        {
            "name": "Chats",
            "short_name": "Chats",
            "url": "./?open=chats",
            "icons": [
                {
                    "src": "icon-dev-192x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Today",
            "short_name": "Today",
            "url": "./?open=today",
            "icons": [
                {
                    "src": "icon-dev-192x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Notes",
            "short_name": "Notes",
            "url": "./?open=notes",
            "icons": [
                {
                    "src": "icon-dev-192x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "New entry",
            "short_name": "Entry",
            "url": "./?open=entry",
            "icons": [
                {
                    "src": "icon-dev-192x192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        }
    ]
}

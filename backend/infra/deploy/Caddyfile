# Caddy для Parvane на m60-7: статика web-клиента + WSS gateway по пути /ws.
# Пока домена нет — self-signed (tls internal) на внешний IP; когда появится
# DuckDNS-домен, адрес сайта и tls заменить на DNS-01.
# Внешний вход: https://{PARVANE_PUBLIC_HOST}:20443 (NAT 20443 -> 443).

{
	# Заход по IP — браузер НЕ шлёт SNI; без default_sni Caddy не выбирает
	# сертификат и рвёт handshake (tlsv1 alert internal error)
	default_sni {$PARVANE_PUBLIC_HOST}
	# Авто-редирект Caddy на :80 не знает про внешний порт 20443 —
	# редиректим сами (сайт http://:80 ниже)
	auto_https disable_redirects
}

(app) {
	handle /ws {
		reverse_proxy gateway:9222
	}

	# Федерация (spec 028): подписанные кадры других серверов — шарду federation
	handle /_parvane/s2s {
		request_body {
			max_size 5MB
		}
		reverse_proxy federation:9330
	}

	# Протокол v2 (spec 007): подписанный описатель сервера. Файл пишет
	# identity (PARVANE_WELL_KNOWN_FILE) в общий том well-known.
	handle /.well-known/parvane {
		root * /srv/well-known
		rewrite * /parvane.json
		header Content-Type "application/json"
		header Cache-Control "no-cache"
		file_server
	}

	# Ссылка-приглашение v2 `/join/<link_id>#<секрет>`: web собран с относительными
	# путями ассетов и из `/join/…` не загрузится — переводим на корень. Фрагмент
	# с секретом браузер переносит сам, серверу он не уходит (то же делает
	# плагин vite для dev/preview — web/telegram-tt/vite.config.ts).
	@v2invite path_regexp v2invite ^/join/([A-Za-z0-9_-]{43})$
	redir @v2invite /?join={re.v2invite.1} 302

	# Публичная группа `/@имя` (spec 023): приложение откроет её по `?resolve=` (то же — плагин vite)
	@publicname path_regexp publicname ^/@([A-Za-z][A-Za-z0-9_]{4,31})$
	redir @publicname /?resolve={re.publicname.1} 302

	# Ссылка на файлы облака для людей без аккаунта `/s/<link_id>#k=<ключ>`
	# (spec 022): публичная страница — отдельный вход сборки `s.html`.
	# Идентификатор — ровно 22 знака base64url, иное сюда не попадает; ключ во
	# фрагменте браузер переносит сам, серверу он не уходит.
	@cloudlink path_regexp cloudlink ^/s/([A-Za-z0-9_-]{22})$
	redir @cloudlink /s.html?id={re.cloudlink.1} 302

	# Кэш: хешированные ассеты (/assets/name-<hash>.js) можно держать вечно —
	# новый деплой даёт новые имена. Нет файла — 404, а не index.html (B3):
	# открытая вкладка прошлой сборки, догружая свой ленивый кусок, получала
	# HTML вместо JS и падала с невнятной ошибкой разбора; 404 ловит
	# `moduleLoader` и предлагает перезагрузку. Ассеты прошлой сборки deploy.sh
	# оставляет на один деплой, так что обычно файл на месте.
	handle /assets/* {
		root * /srv/dist
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/dist
		encode zstd gzip
		# index.html и корневые воркеры (в т.ч. service worker) — ВСЕГДА
		# перепроверять: без Cache-Control браузер кэшировал index.html
		# эвристически и продолжал ссылаться на старый JS даже после обновления
		# страницы («баг не уходит после деплоя»). Исключение — картинки эмодзи
		# img-apple-64/160: имена без хеша, но содержимое не меняется; под
		# no-cache панель эмодзи давала сотни 304 при каждом открытии (B3)
		@emoji path /img-apple-*
		header @emoji Cache-Control "public, max-age=2592000"
		@volatile not path /img-apple-*
		header @volatile Cache-Control "no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

{$PARVANE_PUBLIC_HOST}:443 {
	# Настоящий серт Let's Encrypt через DNS-01 (плагин duckdns) — HTTP-01
	# недоступен (наружу проброшен не 80). Токен в env DUCKDNS_TOKEN.
	# Для self-signed без домена — заменить весь блок на `tls internal`.
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}

	# Сайт открыт: пароля круга (basic_auth) больше нет — барьер от мусорных
	# аккаунтов теперь регистрация с подтверждением почты у identity
	# (PARVANE_EMAIL_REQUIRED=1 + PARVANE_SMTP_* в .env). Вернуть приватный
	# круг: блок `basic_auth { {$PARVANE_SITE_USER} {$PARVANE_SITE_HASH} }`
	# на ВЕСЬ сайт, включая /ws (см. README, история 2026-09-01).

	# P-32: защитные заголовки — HSTS, запрет фрейминга (clickjacking),
	# nosniff, referrer, минимальные permissions. CSP страницы задаёт сборка
	# web (vite buildCsp), frame-ancestors — только заголовком.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Адрес .onion (spec 025): Tor Browser предлагает перейти на скрытый сервис. Файл пишет deploy.sh по
	# адресу из тома tor-data; без Tor — пустой
	import onion-location.caddy

	import app
}

http://:80 {
	redir https://{$PARVANE_PUBLIC_HOST}:{$PARVANE_PUBLIC_HTTPS_PORT}{uri}
}

# Скрытый сервис Tor (spec 025): контейнер tor живёт в сетевом пространстве caddy и ведёт .onion на этот
# порт. Наружу порт не публикуется. Без TLS (у .onion шифрование и подлинность — в самом Tor), без HSTS и без
# перенаправления на обычный адрес — иначе Tor Browser ушёл бы с .onion
http://:8081 {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	import app
}

# Caddy для Parvane на m60-7: статика web-клиента + WSS gateway по пути /ws.
# Пока домена нет — self-signed (tls internal) на внешний IP; когда появится
# DuckDNS-домен, адрес сайта и tls заменить на DNS-01.
# Внешний вход: https://{PARVANE_PUBLIC_HOST}:20443 (NAT 20443 -> 443).

{
	# Заход по IP — браузер НЕ шлёт SNI; без default_sni Caddy не выбирает
	# сертификат и рвёт handshake (tlsv1 alert internal error)
	default_sni {$PARVANE_PUBLIC_HOST}
	# Авто-редирект Caddy на :80 не знает про внешний порт 20443 —
	# редиректим сами (сайт http://:80 ниже)
	auto_https disable_redirects
}

{$PARVANE_PUBLIC_HOST}:443 {
	# Настоящий серт Let's Encrypt через DNS-01 (плагин duckdns) — HTTP-01
	# недоступен (наружу проброшен не 80). Токен в env DUCKDNS_TOKEN.
	# Для self-signed без домена — заменить весь блок на `tls internal`.
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
	}

	# Приватный круг: basic-auth на ВЕСЬ сайт, включая /ws — иначе регистрацию
	# можно было бы дёрнуть напрямую по WebSocket мимо пароля. Браузер после
	# ввода пароля кэширует его для origin и подставляет в т.ч. в WS-хендшейк.
	# Юзер/хэш — из .env (PARVANE_SITE_USER / PARVANE_SITE_HASH, bcrypt).
	# Пусто = гейт выключен (открытый режим).
	basic_auth {
		{$PARVANE_SITE_USER:parvane} {$PARVANE_SITE_HASH}
	}

	handle /ws {
		reverse_proxy gateway:9222
	}

	handle {
		root * /srv/dist
		encode gzip
		try_files {path} /index.html
		file_server
	}
}

http://:80 {
	redir https://{$PARVANE_PUBLIC_HOST}:{$PARVANE_PUBLIC_HTTPS_PORT}{uri}
}

# Gateway — единственная точка входа клиентов в шину (WebSocket → NATS).
PARVANE_GATEWAY_BIND=0.0.0.0:9222
PARVANE_NATS_URL=nats://127.0.0.1:4222
# Доверенный NATS-логин gateway (широкие права; изоляция людей — в самом gateway).
PARVANE_NATS_USER=gateway
PARVANE_NATS_PASS=change-me
PARVANE_LOG_LEVEL=info

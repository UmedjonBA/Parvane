{
  "rules": [
    {
      "id": "SYNC-1",
      "title": "Дисковый курсор двигается только по применённому",
      "cases": [
        { "name": "чистый проход", "applied": true, "e2eReady": true, "persistCursor": true },
        { "name": "нерасшифрованное", "applied": false, "e2eReady": true, "persistCursor": false },
        { "name": "E2E не поднялся", "applied": false, "e2eReady": false, "persistCursor": false },
        { "name": "умышленный отказ (подмена отправителя)", "applied": false, "e2eReady": true,
          "deliberateReject": true, "persistCursor": true }
      ]
    },
    {
      "id": "SYNC-2",
      "title": "Непрочитанное не держит курсор вечно",
      "maxRepairAttempts": 3
    },
    {
      "id": "PROFILE-1",
      "title": "Профиль перечитывается по TTL",
      "maxCacheAgeMs": 600000
    },
    {
      "id": "READ-1",
      "title": "Прочитанное журналируется локально и подтверждается",
      "cases": [
        { "name": "серверный флаг есть", "serverRead": true, "localRead": false, "isRead": true },
        { "name": "только локальный журнал", "serverRead": false, "localRead": true, "isRead": true },
        { "name": "ни того, ни другого", "serverRead": false, "localRead": false, "isRead": false }
      ]
    },
    {
      "id": "MAP-1",
      "title": "Фрагменты карты — только через шард preview",
      "tileTopic": "preview.map.tile",
      "tileSize": 256,
      "defaultZoom": 16,
      "forbiddenHosts": [
        "tile.openstreetmap.org",
        "tile.osm.org",
        "maps.googleapis.com",
        "mt0.google.com",
        "core-renderer-tiles.maps.yandex.net"
      ],
      "clients": {
        "web": "web/telegram-tt/src/api/parvane/media.ts",
        "desktop": [
          "desktop/parvane-core/src/map_tiles.cpp",
          "desktop/tdesktop/Telegram/SourceFiles/parvane/parvane_map.cpp"
        ],
        "android": "n/a: карт нет"
      }
    }
  ]
}

{
  "rules": [
    {
      "id": "SYNC-1",
      "title": "Дисковый курсор двигается только по применённому",
      "cases": [
        {
          "name": "чистый проход",
          "applied": true,
          "e2eReady": true,
          "persistCursor": true
        },
        {
          "name": "нерасшифрованное",
          "applied": false,
          "e2eReady": true,
          "persistCursor": false
        },
        {
          "name": "E2E не поднялся",
          "applied": false,
          "e2eReady": false,
          "persistCursor": false
        },
        {
          "name": "умышленный отказ (подмена отправителя)",
          "applied": false,
          "e2eReady": true,
          "deliberateReject": true,
          "persistCursor": true
        }
      ],
      "clients": {
        "web": "web/telegram-tt/src/api/parvane/sync.ts (persistCursor, sawUndecryptable)",
        "desktop": "tdesktop/Telegram/SourceFiles/parvane/parvane_client.cpp (prepareIncoming → NotePendingAndMayAdvance)",
        "android": "jni/parvane_jni.cpp (enum class Deliver, g_diskCursorId → cursors.json только после Applied, pending.json) — сценарий эмулятора android/tgx_conformance_flow.sh шаг 1 («устройство отсутствовало»: X выключен, 3 сообщения, включён → все три + «курсор: … применён», ничего не придержано)"
      }
    },
    {
      "id": "SYNC-2",
      "title": "Непрочитанное не держит курсор вечно",
      "maxRepairAttempts": 3,
      "clients": {
        "web": "web/telegram-tt/src/api/parvane/sync.ts (mayAdvanceDiskCursor) + localState.ts (loadRepairAttempts)",
        "desktop": "tdesktop/Telegram/SourceFiles/parvane/parvane_client.cpp (NotePendingAndMayAdvance, kRepairAttempts, tdata/parvane-pending.txt)",
        "android": "jni/parvane_jni.cpp (kRepairAttempts = 3, pending.json, маркеры «курсор придержан: … (n/3)» и «курсор отпущен после 3 попыток (SYNC-2)») — сценарий android/tgx_conformance_flow.sh шаг 1 проверяет, что на чистом проходе ничего не придержано"
      }
    },
    {
      "id": "PROFILE-1",
      "title": "Профиль перечитывается по TTL",
      "maxCacheAgeMs": 600000,
      "clients": {
        "web": "web/telegram-tt/src/api/parvane/sync.ts (resolveDisplayNames на каждом проходе синка)",
        "desktop": "tdesktop/Telegram/SourceFiles/parvane/parvane_client.cpp (g_resolvedAt + kProfileTtlMs)",
        "android": "libtd/src/main/java/org/drinkless/tdlib/Client.kt (resolvedAt, profileTtlMs = 10 мин, тик 60 с; тестовый override /data/local/tmp/parvane-profile-ttl в мс) — сценарий android/tgx_conformance_flow.sh шаг 3 (bio сменён на desktop → «профиль bob@local: …» второй раз без перезапуска, TTL 20 с)"
      }
    },
    {
      "id": "READ-1",
      "title": "Прочитанное журналируется локально и подтверждается",
      "cases": [
        {
          "name": "серверный флаг есть",
          "serverRead": true,
          "localRead": false,
          "isRead": true
        },
        {
          "name": "только локальный журнал",
          "serverRead": false,
          "localRead": true,
          "isRead": true
        },
        {
          "name": "ни того, ни другого",
          "serverRead": false,
          "localRead": false,
          "isRead": false
        }
      ],
      "clients": {
        "web": "web/telegram-tt/src/api/parvane/localState.ts (loadReadUuids/saveReadUuids) + sync.ts (retryUnconfirmedReads)",
        "desktop": "tdesktop/Telegram/SourceFiles/parvane/parvane_client.cpp (g_reportedRead, tdata/parvane-read.txt, RetryUnconfirmedReads)",
        "android": "jni/parvane_jni.cpp (read.json + журнал ДО msg.chat.read — «прочитано локально»; g_unconfirmedRead повторяется в pumpLoop до read=true — «read подтверждён») — сценарий android/tgx_conformance_flow.sh шаг 2 (после рестарта X бейдж не возвращается)"
      }
    },
    {
      "id": "MAP-1",

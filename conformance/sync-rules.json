      "tileTopic": "preview.map.tile",
      "tileSize": 256,
      "defaultZoom": 16,
      "forbiddenHosts": [
        "tile.openstreetmap.org",
        "tile.osm.org",
        "maps.googleapis.com",
        "mt0.google.com",
        "core-renderer-tiles.maps.yandex.net"

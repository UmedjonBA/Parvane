{
  "rules": [
    {
      "id": "SYNC-1",
      "title": "Дисковый курсор двигается только по применённому",
      "cases": [
        {
          "name": "чистый проход",
          "applied": true,
          "e2eReady": true,
          "persistCursor": true
        },
        {
          "name": "нерасшифрованное",
          "applied": false,
          "e2eReady": true,
          "persistCursor": false
        },
        {
          "name": "E2E не поднялся",
          "applied": false,
          "e2eReady": false,
          "persistCursor": false
        },
        {
          "name": "умышленный отказ (подмена отправителя)",
          "applied": false,
          "e2eReady": true,
          "deliberateReject": true,
          "persistCursor": true
        }
      ]
    },
    {
      "id": "SYNC-2",
      "title": "Непрочитанное не держит курсор вечно",
      "maxRepairAttempts": 3
    },
    {
      "id": "PROFILE-1",
      "title": "Профиль перечитывается по TTL",
      "maxCacheAgeMs": 600000
    },
    {
      "id": "READ-1",
      "title": "Прочитанное журналируется локально и подтверждается",
      "cases": [
        {
          "name": "серверный флаг есть",
          "serverRead": true,
          "localRead": false,
          "isRead": true
        },
        {
          "name": "только локальный журнал",
          "serverRead": false,
          "localRead": true,
          "isRead": true
        },
        {
          "name": "ни того, ни другого",
          "serverRead": false,
          "localRead": false,
          "isRead": false
        }
      ]
    },
    {
      "id": "E2E-1",
      "title": "Автор из провода, SKDM из identity конверта, неподтверждённое не показывается",
      "groupAuthor": "wireFrom",
      "megolmPlaintext": "bareContent",
      "acceptsLegacyWrapper": true,
      "skdmBoundToEnvelopeIdentity": true,
      "unknownVerdict": {
        "show": false,
        "ack": false,
        "retry": true
      }
    },
    {
      "id": "LINK-1",
      "title": "Линковка v2: обязательство, challenge, SAS от пары ключей, без приватного аккаунта",
      "sasDigits": 12,
      "sasInfo": "parvane-link-sas-v2",
      "commitment": "base64(sha256(raw eph_pub))",
      "exportLinkVersion": 2,
      "exportContainsPrivateAccount": false,
      "transferStatement": "link-transfer:<user>:<old_signing_key>:<new_signing_key>",
      "acceptsLegacyOffers": false,
      "vectors": {
        "newPubB64": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
        "oldPubB64": "BAEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=",
        "commitmentOfNew": "mM5C3u9R1AJp1UL1MUvvLHRo1AGtXYUWi/q0wBCPdfc=",
        "sas": "5659 7031 8371"
      }
    },
    {
      "id": "KEY-1",
      "title": "Смена ключа контакта — по виденным identity (TOFU); signed_prekey только с подписью signing_key",
      "keyChangeSource": "seenIdentities",
      "catalogSeedsSeenOnlyOnFirstContact": true,
      "prekeySignatureRequiredInDeviceList": true,
      "legacyBundleWithoutSigningKeyAccepted": true,
      "allDevicesRejectedVerdict": "unknown"
    }
  ]
}
